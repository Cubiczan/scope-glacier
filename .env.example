# Scope.Glacier environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- AWS ---
AWS_REGION=us-east-1

# --- Data source API keys ---
# US EIA Open Data API key (free at https://www.eia.gov/opendata/)
EIA_API_KEY=your-eia-api-key
# AlphaVantage API key
ALPHA_VANTAGE_KEY=your-alphavantage-api-key
# FRED (St. Louis Fed) API key
FRED_API_KEY=your-fred-api-key

# --- Amazon Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- Data lake / query config ---
RAW_BUCKET=scope-glacier-raw
GLUE_DATABASE=scope_glacier
ATHENA_OUTPUT=s3://scope-glacier-queries/

# --- Lambda runtime (optional) ---
# SSM Parameter Store path for the EIA key (preferred over EIA_API_KEY in Lambda)
EIA_API_KEY_PARAM=/scope-glacier/eia_api_key

# --- StarRocks spike (optional; Athena remains the batch engine) ---
# Docs: docs/STARROCKS.md
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=
# auto uses the Glue Iceberg catalog when it is registered, otherwise fixtures
STARROCKS_SOURCE=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Used only to CREATE EXTERNAL CATALOG against the existing Glue database.
# Leave unset to run the local fixture database scope_glacier_demo.
